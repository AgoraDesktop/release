# Build output
/build/

# Debian build artifacts. debian/changelog and the split lists are generated by
# `make deb` from the checked-out tag and from what was installed, so they are
# not tracked.
/debian/changelog
/debian/files
/debian/agora-files
/debian/agora-links
/debian/agora.install
/debian/agora-dev.install
/debian/tmp/
/debian/agora/
/debian/agora-dev/
/debian/agora-dbgsym/
/debian/.debhelper/
/debian/*.substvars
/debian/*.debhelper
